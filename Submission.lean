  have finalThetaFacts (F Ω : Type) [NormedField F] [CompleteSpace F] [NormedField Ω]
      [NormedAlgebra F Ω] [Algebra.IsAlgebraic F Ω]
      (hΩ : ∀ x y : Ω, ‖x + y‖ ≤ max ‖x‖ ‖y‖)
      (q : F) (hq0 : 0 < ‖q‖) (hq1 : ‖q‖ < 1) :
      let Q : Ω := algebraMap F Ω q
      let A : Ω → Ω := fun a => ∏' n : ℕ, (1 - Q ^ (n + 1) * a)
