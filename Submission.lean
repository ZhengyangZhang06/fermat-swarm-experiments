        degree Dz = (Algebra.norm (Polynomial k) z).natDegree := by
    let S := (Algebra.norm (Polynomial k) z).roots.toFinset.biUnion xFiber
    have hS (P : W.toAffine.Point) (hP : P ∉ S) : pointOrder z P = 0 := by
      cases P with
      | zero => rfl
      | some α β h =>
