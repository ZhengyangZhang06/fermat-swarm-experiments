      · rw [hcoeff0, norm_mul, huI0, hJ0, one_mul]
    have heval : ∀ (K : Type) [NormedField K] [CompleteSpace K],
        ∀ (f g : PowerSeries K) (A B : ℝ), 0 ≤ A → 0 ≤ B →
          (∀ n : ℕ, ‖PowerSeries.coeff n f‖ ≤ A) →
          (∀ n : ℕ, ‖PowerSeries.coeff n g‖ ≤ B) →
          ∀ z : K, ‖z‖ < 1 →
