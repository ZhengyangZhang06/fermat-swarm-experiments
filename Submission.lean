          · exact Or.inr (Or.inr he)
      · apply (Set.finite_singleton (0 : G)).subset
        intro P hp
        cases P with
        | zero => rfl
        | some u v hv => exact (h ⟨v, (show u = x from hp) ▸ hv⟩).elim
    have ev_nonzero (a : A) (ha : a ≠ 0) : ∀ᶠ P in Filter.cofinite, ev P a ≠ 0 := by
